<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link href="~/css/styles.css" rel="stylesheet" />
    <script src="~/js/scripts.js"></script>
    <!-- Sử dụng Bootstrap 5 trực tiếp từ CDN, không cần file styles.css -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Thư viện icon FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css" rel="stylesheet" />
    <style>
            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            #layoutSidenav {
                display: flex;
                flex: 1;
            }

            #layoutSidenav_nav {
                width: 225px;
                background-color: #212529;
                min-height: calc(100vh - 56px);
            }

            #layoutSidenav_content {
                flex: 1;
                padding: 20px;
            }

            .sb-topnav {
                background-color: #212529;
            }
    </style>
</head>
<body class="sb-nav-fixed">
    <!-- Top Nav -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark px-3 justify-content-between">
        <a class="navbar-brand ps-3" href="#">Management System</a>
        <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <div class="input-group">
                <input class="form-control" type="text" placeholder="Search for..." />
                <button class="btn btn-primary" type="button"><i class="fas fa-search"></i></button>
            </div>
        </form>
    </nav>

    <div id="layoutSidenav">
        <!-- Left Menu -->
        <div id="layoutSidenav_nav">
            <div class="nav flex-column nav-pills p-3 text-white">
                <div class="text-uppercase text-secondary fw-bold small mb-2">CORE</div>
                <a class="nav-link text-white" href="#">Dashboard</a>
                <div class="text-uppercase text-secondary fw-bold small my-2">ADDONS</div>
                <a class="nav-link text-white" href="#">Branches</a>
                <a class="nav-link text-white active" href="/Admin/Student/List">Students</a>
            </div>
        </div>

        <!-- Right Content -->
        <div id="layoutSidenav_content">
            <main class="container-fluid px-4">
                @RenderBody() <!-- Nơi hiển thị nội dung các trang con như Index, Create -->
            </main>

            <!-- Footer -->
            <footer class="py-4 bg-light mt-auto border-top">
                <div class="container-fluid px-4 text-muted small">
                    Copyright &copy; MyWebApp 2026
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>