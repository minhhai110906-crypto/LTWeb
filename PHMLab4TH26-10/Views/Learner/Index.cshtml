@model IEnumerable<PHMLab4TH26_10.Models.Learner>

@{
    ViewData["Title"] = "Index";
}

<div class="ms-2 mx-2">
    <h1>Learner List</h1>
    @await Component.InvokeAsync("Major")  
    <!-- Thêm form tìm kiếm vào đây -->
    <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0 float-end mb-3">
        <div class="input-group">
            <input id="keyword" class="form-control" name="keyword" type="text" placeholder="Search learner" />
            <button id="btnSearch" class="btn btn-primary" type="button">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
    </form>
    <div id="content">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Họ</th>
                    <th>Ngành</th>
                    <th>Ngày Nhập Học</th>
                    <th>Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.LearnerID</td>
                        <td>@s.FirstMidName</td>
                        <td>@s.LastName</td>
                        <td>@s.Major?.MajorName</td>
                        <td>@s.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.LearnerID">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@s.LearnerID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Thêm thanh nav-phân trang bên trong div#content để AJAX cập nhật được -->
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.pageNum; i++)
            {
                <li class="page-item page="@i"
                    @(ViewBag.mid != null ? "mid=" + ViewBag.mid : "")
                    @(ViewBag.keyword != null ? "keyword=" + ViewBag.keyword : "")>
                    <a class="page-link" style="cursor: pointer;">@i</a>
                </li>
            }
        </ul>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</div>
@section Scripts {
    <script>
        $(function () {
            // 1. Sự kiện phân trang dùng ủy quyền chuẩn xác cho các phần tử động trong #content
            $(document).on('click', '.page-item', function (e) {
                e.preventDefault();
                var page = $(this).attr("page");
                var mid = $(this).attr("mid");
                var keyword = $(this).attr("keyword");
                var data = { mid: mid, keyword: keyword, pageIndex: page };
                
                $.ajax({
                    url: '@Url.Action("LearnerFilter", "Learner")',
                    data: data,
                    success: function (response) {
                        $("div#content").html(response);
                    }
                });
            });

            // 2. Sự kiện click chọn chuyên ngành trên menu
            $(document).on("click", ".nav li, .nav-item", function () {
                var id = $(this).attr("id");
                if (!id) return;
                
                $.ajax({
                    url: '@Url.Action("LearnerFilter", "Learner")',
                    data: { mid: id },
                    success: function (response) {
                        $("div#content").html(response);
                    }
                });
            });

            // 3. Sự kiện click nút tìm kiếm
            $('#btnSearch').click(function (e) {
                var keyword = $('#keyword').val();
                
                $.ajax({
                    url: '@Url.Action("LearnerFilter", "Learner")',
                    data: { keyword: keyword },
                    success: function (response) {
                        $("div#content").html(response);
                    }
                });
            });
        });
    </script>
}