<div id="bookCarousel" class="carousel slide" data-bs-ride="carousel">
    <!-- Các dấu chấm chuyển slide -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#bookCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#bookCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#bookCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <!-- Khung chứa hình ảnh slide -->
    <div class="carousel-inner rounded shadow mb-4">
        <div class="carousel-item active">
            <img src="~/images/banner1.jpg" class="d-block w-100" alt="Banner 1" style="height: 350px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                <h5>Học lập trình ASP.NET Core MVC</h5>
                <p>Khám phá mô hình quản lý sách hiệu quả.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/banner2.jpg" class="d-block w-100" alt="Banner 2" style="height: 350px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                <h5>Quản lý kho sách thông minh</h5>
                <p>Thực hành thêm, sửa, xóa dữ liệu với Model.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/banner3.jpg" class="d-block w-100" alt="Banner 3" style="height: 350px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                <h5>Phát triển ứng dụng Web</h5>
                <p>Tối ưu hóa giao diện với Bootstrap 5.</p>
            </div>
        </div>
    </div>

    <!-- Nút bấm qua lại trái/phải -->
    <button class="carousel-control-prev" type="button" data-bs-target="#bookCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#bookCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>