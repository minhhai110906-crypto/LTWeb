@model IEnumerable<PHMLesson4.Models.Book>

@foreach (var item in Model){
    <div class="col-3">
        <div class="card mb-3 shadow-sm">
            <img src="@item.Image" class="card-img-top" alt="Book Image" style="height: 200px; object-fit: cover;">
            <div class="card-body">
                <h5 class="card-title">@item.Title</h5>
                <p class="card-text">
                    Price: @item.Price
                </p>
            </div>
        </div>
    </div>
}