@model PHMLesson6.Models.PHMMember

@{
    ViewData["Title"] = "PHMCreate";
}

<h1>PHMCreate</h1>

<h4>PHMMember</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="PHMCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PHMMemberId" class="control-label"></label>
                <input asp-for="PHMMemberId" class="form-control" />
                <span asp-validation-for="PHMMemberId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PHMMemberUserName" class="control-label"></label>
                <input asp-for="PHMMemberUserName" class="form-control" />
                <span asp-validation-for="PHMMemberUserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PHMMemberPassword" class="control-label"></label>
                <input asp-for="PHMMemberPassword" class="form-control" />
                <span asp-validation-for="PHMMemberPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PHMMemberEmail" class="control-label"></label>
                <input asp-for="PHMMemberEmail" class="form-control" />
                <span asp-validation-for="PHMMemberEmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PHMMemberFullName" class="control-label"></label>
                <input asp-for="PHMMemberFullName" class="form-control" />
                <span asp-validation-for="PHMMemberFullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="PHMIndex">Back to List</a>
</div>
